; Download the Isabelle and build the TLA+ theory with it.
; The source code for the TLA+ theory is in the $PROJECT_ROOT/isabelle directory.

(rule
 (alias default)
 (deps
  "dune.mk"
  (source_tree ../../isabelle)
  (sandbox none))
 (targets
  (dir "Isabelle")
  (dir "Isabelle-test")
  (dir "Isabelle-install"))
 (action
  (run "make" "-f" "dune.mk")))

(install
 (section
  (site
   (tlapm backends)))
 (dirs Isabelle-install))
